<?xml version="1.0" encoding="utf-8"?>
<!--
    Средний виджет (~4x2 ячейки). Показывает город, температуру,
    описание погоды, дату/день недели и полосу переключения городов
    (геолокация + до 4 избранных, помещающихся по ширине). Тап по чипсу
    города меняет данные в самом виджете мгновенно (без сети — см.
    WeatherWidgetProvider.handleCitySelection), тап по остальной части
    виджета открывает приложение.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Верхний блок: город слева, дата справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_city_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B8C4E0"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Средний блок: иконка + температура + описание -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_clear_day" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—°"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#D3DBEF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Нижний блок: переключатель городов (чипсы) -->
        <LinearLayout
            android:id="@+id/widget_city_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/widget_chip_0"
                style="@style/WidgetCityChip"
                android:text="" />

            <TextView
                android:id="@+id/widget_chip_1"
                style="@style/WidgetCityChip"
                android:text="" />

            <TextView
                android:id="@+id/widget_chip_2"
                style="@style/WidgetCityChip"
                android:text="" />

            <TextView
                android:id="@+id/widget_chip_3"
                style="@style/WidgetCityChip"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
